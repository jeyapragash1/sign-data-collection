# Copy to .env; never commit the actual file.
DATA_DIR=./private-data
PORT=8000
# Local default remains SQLite; hosted use Neon/PostgreSQL.
# DATABASE_URL=postgresql+psycopg://research_user:CHANGE_ME@ep-xxxx.us-east-2.aws.neon.tech/sign_research?sslmode=require
# PGSSLMODE=require
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
STORAGE_BACKEND=local
MAX_UPLOAD_MB=150
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Host-secret key used to encrypt stored Google refresh tokens.
TOKEN_ENCRYPTION_KEY=
# Google OAuth Web Application credentials (backend only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/storage/drive/callback
# On HTTPS deployments set COOKIE_SECURE=true. Use COOKIE_SAMESITE=none only when frontend/API are cross-site.
