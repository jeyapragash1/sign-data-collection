/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob: https://*.onrender.com https://*.render.com; connect-src 'self' https://*.onrender.com https://*.render.com https://*.pages.dev https://*.googleapis.com; frame-ancestors 'none'
